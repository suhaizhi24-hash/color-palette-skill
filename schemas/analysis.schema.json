{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color Palette Analysis 0.15.0",
  "type": "object",
  "required": [
    "schema_version",
    "ruleset_version",
    "official_language",
    "zero_token",
    "source",
    "analysis",
    "tone",
    "contrast",
    "saturation",
    "white_balance",
    "tonal_palette",
    "skin",
    "lighting",
    "light",
    "material_effects",
    "effects",
    "official_report",
    "render_policy"
  ],
  "properties": {
    "schema_version": {"const": "0.15.0"},
    "ruleset_version": {"const": "p1-rules-0.10.0"},
    "official_language": {"const": "zh-CN"},
    "zero_token": {"const": true},
    "source": {
      "type": "object",
      "required": [
        "filename",
        "format",
        "source_mode",
        "width",
        "height",
        "orientation",
        "sha256",
        "orientation_applied",
        "icc_present",
        "icc_conversion_applied",
        "working_space",
        "has_alpha",
        "valid_pixel_share",
        "analysis_source",
        "render_color_adjustment"
      ],
      "properties": {
        "filename": {"type": "string"},
        "format": {"type": ["string", "null"]},
        "source_mode": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "orientation": {"enum": ["portrait", "landscape", "square"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "orientation_applied": {"type": "boolean"},
        "icc_present": {"type": "boolean"},
        "icc_conversion_applied": {"type": "boolean"},
        "working_space": {"const": "sRGB"},
        "has_alpha": {"type": "boolean"},
        "valid_pixel_share": {"type": "number", "minimum": 0, "maximum": 1},
        "analysis_source": {"const": "original"},
        "render_color_adjustment": {"const": false}
      }
    },
    "tone": {
      "type": "object",
      "required": ["code", "label", "l_percentiles", "shares", "clipping"]
    },
    "contrast": {
      "type": "object",
      "required": ["span_l", "level", "description"],
      "properties": {"level": {"enum": ["低", "中", "高"]}}
    },
    "saturation": {
      "type": "object",
      "required": ["metric", "median", "level", "shares", "description"],
      "properties": {"level": {"enum": ["低", "中", "高"]}}
    },
    "white_balance": {
      "type": "object",
      "required": [
        "status",
        "judgement",
        "neutral_share",
        "neutral_spatial_coverage"
      ],
      "properties": {
        "neutral_share": {"type": "number", "minimum": 0, "maximum": 1},
        "neutral_spatial_coverage": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "tonal_palette": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "skin": {
      "type": "object",
      "required": [
        "status",
        "face_count",
        "detector",
        "requested_backend",
        "available_backends",
        "backend_degraded",
        "primary_anchor",
        "secondary_anchor"
      ],
      "properties": {
        "status": {"enum": ["单人", "多人不合并", "无人像", "未验证"]},
        "requested_backend": {"enum": ["auto", "opencv", "dlib", "none"]},
        "backend_degraded": {"type": "boolean"}
      }
    },
    "lighting": {
      "type": "object",
      "required": [
        "ruleset_version",
        "source",
        "quality",
        "ratio",
        "subject_roi",
        "debug"
      ],
      "properties": {
        "ruleset_version": {"const": "lighting-0.14.0"},
        "source": {
          "type": "object",
          "required": ["code", "display_name"],
          "properties": {
            "code": {
              "enum": [
                "natural",
                "studio",
                "flash",
                "mixed",
                "self_luminous",
                "unknown"
              ]
            },
            "display_name": {
              "enum": ["自然光", "人工棚拍", "人工闪光", "混合光", "自发光", "暂不判定"]
            }
          },
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "required": ["code", "display_name"],
          "properties": {
            "code": {"enum": ["hard", "soft", "not_applicable", "unknown"]},
            "display_name": {"enum": ["硬光", "柔光", "不适用", "暂不判定"]}
          },
          "additionalProperties": false
        },
        "ratio": {
          "type": "object",
          "required": ["code", "display_name"],
          "properties": {
            "code": {"enum": ["low", "medium", "high", "not_applicable", "unknown"]},
            "display_name": {"enum": ["低", "中", "高", "不适用", "暂不判定"]}
          },
          "additionalProperties": false
        },
        "subject_roi": {
          "type": "object",
          "required": ["type", "box", "valid_share"],
          "properties": {
            "type": {"enum": ["face", "upper_body", "full_body", "main_subject"]},
            "box": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "integer", "minimum": 0}
            },
            "valid_share": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "debug": {"type": "object"}
      },
      "additionalProperties": false
    },
    "light": {
      "type": "object",
      "required": ["source", "quality", "ratio", "status"],
      "properties": {
        "source": {"enum": ["自然光", "人工棚拍", "人工闪光", "混合光", "自发光", "暂不判定"]},
        "quality": {"enum": ["硬光", "柔光", "不适用", "暂不判定"]},
        "ratio": {"enum": ["低", "中", "高", "不适用", "暂不判定"]},
        "status": {"enum": ["已分析", "兼容旧版"]}
      },
      "additionalProperties": false
    },
    "material_effects": {
      "type": "object",
      "required": ["ruleset_version", "items", "summary", "status", "diagnostics"],
      "properties": {
        "ruleset_version": {"const": "material-fx-0.13.0"},
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/materialEffectItem"}
        },
        "summary": {"type": "string", "minLength": 1},
        "status": {"enum": ["已识别", "未发现明显"]},
        "diagnostics": {"type": "object"}
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "required": ["detected", "not_obvious", "conclusion", "status"]
    },
    "quantitative": {"$ref": "#/$defs/quantitative"},
    "color_dna": {"$ref": "#/$defs/colorDna"},
    "render_policy": {
      "type": "object",
      "required": ["official_report_format", "generate_jpg", "render_color_adjustment"],
      "properties": {
        "official_report_format": {"const": "png"},
        "generate_jpg": {"const": false},
        "render_color_adjustment": {"const": false}
      }
    },
    "official_report": {
      "type": "object",
      "required": [
        "官方语言",
        "官方模块",
        "影调结构",
        "明暗关系",
        "色彩浓度",
        "白平衡&色相",
        "影调色卡",
        "肤色锚点",
        "素材特效&光线构成"
      ],
      "properties": {
        "官方模块": {
          "const": [
            "影调结构",
            "明暗关系",
            "色彩浓度",
            "白平衡&色相",
            "影调色卡",
            "肤色锚点",
            "素材特效&光线构成"
          ]
        },
        "素材特效&光线构成": {
          "type": "object",
          "required": ["素材特效", "光线构成"],
          "properties": {
            "素材特效": {
              "type": "object",
              "required": ["标签", "结论"],
              "properties": {
                "标签": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "细颗粒",
                      "粗颗粒",
                      "柔化",
                      "高斯模糊",
                      "低清晰度",
                      "高光扩散",
                      "RGB 色彩偏移",
                      "画质降低",
                      "胶片扫描质感",
                      "胶片边框",
                      "灰尘",
                      "划痕",
                      "未发现明显素材特效"
                    ]
                  }
                },
                "结论": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "光线构成": {
              "type": "object",
              "required": ["光源", "光质", "光比"],
              "properties": {
                "光源": {"enum": ["自然光", "人工棚拍", "人工闪光", "混合光", "自发光", "暂不判定"]},
                "光质": {"enum": ["硬光", "柔光", "不适用", "暂不判定"]},
                "光比": {"enum": ["低", "中", "高", "不适用", "暂不判定"]}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "share": {"type": "number", "minimum": 0, "maximum": 1},
    "lstar": {"type": "number", "minimum": 0, "maximum": 100},
    "hueAngle": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
    "nullableNumber": {"type": ["number", "null"]},
    "nullableShare": {
      "anyOf": [
        {"$ref": "#/$defs/share"},
        {"type": "null"}
      ]
    },
    "lab": {
      "type": "object",
      "required": ["l", "a", "b"],
      "properties": {
        "l": {"$ref": "#/$defs/lstar"},
        "a": {"type": "number", "minimum": -160, "maximum": 160},
        "b": {"type": "number", "minimum": -160, "maximum": 160}
      },
      "additionalProperties": false
    },
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 0, "maximum": 255}
    },
    "luminancePercentiles": {
      "type": "object",
      "required": ["p1", "p5", "p25", "p50", "p75", "p95", "p99"],
      "properties": {
        "p1": {"$ref": "#/$defs/lstar"},
        "p5": {"$ref": "#/$defs/lstar"},
        "p25": {"$ref": "#/$defs/lstar"},
        "p50": {"$ref": "#/$defs/lstar"},
        "p75": {"$ref": "#/$defs/lstar"},
        "p95": {"$ref": "#/$defs/lstar"},
        "p99": {"$ref": "#/$defs/lstar"}
      },
      "additionalProperties": false
    },
    "histogram": {
      "type": "object",
      "required": ["range", "bins", "bin_edges", "normalized"],
      "properties": {
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"}
        },
        "bins": {"type": "integer", "minimum": 1},
        "bin_edges": {"type": "array", "items": {"type": "number"}},
        "normalized": {"type": "array", "items": {"$ref": "#/$defs/share"}}
      },
      "additionalProperties": false
    },
    "axisSegment": {
      "type": "object",
      "required": ["status", "sample_share", "sample_count", "a_median", "b_median", "c_median"],
      "properties": {
        "status": {"enum": ["valid", "insufficient"]},
        "sample_share": {"$ref": "#/$defs/share"},
        "sample_count": {"type": "integer", "minimum": 0},
        "a_median": {"$ref": "#/$defs/nullableNumber"},
        "b_median": {"$ref": "#/$defs/nullableNumber"},
        "c_median": {"$ref": "#/$defs/nullableNumber"}
      },
      "additionalProperties": false
    },
    "neutralPaletteItem": {
      "type": "object",
      "required": ["role", "status", "pixel_share", "sample_count", "rgb", "hex", "lab"],
      "properties": {
        "role": {"enum": ["深黑", "阴影", "中间调", "亮部", "高光"]},
        "status": {"enum": ["valid", "insufficient"]},
        "pixel_share": {"$ref": "#/$defs/share"},
        "sample_count": {"type": "integer", "minimum": 0},
        "rgb": {"anyOf": [{"$ref": "#/$defs/rgb"}, {"type": "null"}]},
        "hex": {"type": ["string", "null"], "pattern": "^#[0-9A-F]{6}$"},
        "lab": {"anyOf": [{"$ref": "#/$defs/lab"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "scenePaletteCluster": {
      "type": "object",
      "required": ["id", "role", "role_display_name", "area_share", "lab", "rgb", "hex", "chroma", "hue_angle"],
      "properties": {
        "id": {"type": "string", "pattern": "^cluster_[1-9][0-9]*$"},
        "role": {"enum": ["primary", "secondary", "accent", "other"]},
        "role_display_name": {"enum": ["主色", "辅助色", "点缀色", "其他"]},
        "area_share": {"$ref": "#/$defs/share"},
        "lab": {"$ref": "#/$defs/lab"},
        "rgb": {"$ref": "#/$defs/rgb"},
        "hex": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
        "chroma": {"type": "number", "minimum": 0},
        "hue_angle": {"$ref": "#/$defs/hueAngle"}
      },
      "additionalProperties": false
    },
    "regionStats": {
      "type": "object",
      "required": ["sample_count", "sample_share", "l_p50", "lab_median", "c_p50"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 0},
        "sample_share": {"$ref": "#/$defs/share"},
        "l_p50": {"$ref": "#/$defs/lstar"},
        "lab_median": {"$ref": "#/$defs/lab"},
        "c_p50": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "quantitative": {
      "type": "object",
      "required": [
        "measurement_context",
        "luminance",
        "histograms",
        "contrast",
        "tone_signature",
        "chroma",
        "hue_distribution",
        "neutral_axis",
        "palettes",
        "subject_background",
        "confidence",
        "summary_zh",
        "performance"
      ],
      "properties": {
        "measurement_context": {
          "type": "object",
          "required": ["input_interpretation", "lightness_model", "chroma_model", "edit_parameter_inference"],
          "properties": {
            "input_interpretation": {"const": "ICC标准化后的sRGB显示成片"},
            "lightness_model": {"const": "CIELAB L*"},
            "chroma_model": {"const": "CIELAB C*ab"},
            "edit_parameter_inference": {"const": false}
          },
          "additionalProperties": false
        },
        "luminance": {
          "type": "object",
          "required": ["percentiles", "shares"],
          "properties": {
            "percentiles": {"$ref": "#/$defs/luminancePercentiles"},
            "shares": {
              "type": "object",
              "required": [
                "l_below_5", "l_below_10", "l_above_90", "l_above_95", "l_above_99",
                "near_black_share", "shadow_share", "highlight_share", "near_white_share",
                "black_clip_share", "white_clip_share"
              ],
              "additionalProperties": {"$ref": "#/$defs/share"}
            }
          },
          "additionalProperties": false
        },
        "histograms": {
          "type": "object",
          "required": ["luminance_lstar"],
          "properties": {"luminance_lstar": {"$ref": "#/$defs/histogram"}},
          "additionalProperties": false
        },
        "contrast": {
          "type": "object",
          "required": [
            "global_l_p95_p5", "midtone_l_p75_p25", "kernel_px",
            "local_contrast_median", "local_contrast_p75",
            "subject_local_contrast_median", "background_local_contrast_median"
          ],
          "properties": {
            "global_l_p95_p5": {"type": "number", "minimum": 0, "maximum": 100},
            "midtone_l_p75_p25": {"type": "number", "minimum": 0, "maximum": 100},
            "kernel_px": {"type": "integer", "minimum": 15, "maximum": 61},
            "local_contrast_median": {"$ref": "#/$defs/nullableNumber"},
            "local_contrast_p75": {"$ref": "#/$defs/nullableNumber"},
            "subject_local_contrast_median": {"$ref": "#/$defs/nullableNumber"},
            "background_local_contrast_median": {"$ref": "#/$defs/nullableNumber"}
          },
          "additionalProperties": false
        },
        "tone_signature": {
          "type": "object",
          "required": [
            "black_floor_p1", "shadow_floor_p5", "highlight_ceiling_p99",
            "highlight_headroom", "midtone_spread", "toe_ratio", "shoulder_ratio"
          ],
          "properties": {
            "black_floor_p1": {"$ref": "#/$defs/lstar"},
            "shadow_floor_p5": {"$ref": "#/$defs/lstar"},
            "highlight_ceiling_p99": {"$ref": "#/$defs/lstar"},
            "highlight_headroom": {"$ref": "#/$defs/lstar"},
            "midtone_spread": {"type": "number", "minimum": 0, "maximum": 100},
            "toe_ratio": {"type": "number", "minimum": 0},
            "shoulder_ratio": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "chroma": {
          "type": "object",
          "required": ["percentiles", "shares", "histogram"],
          "properties": {
            "percentiles": {
              "type": "object",
              "required": ["p25", "p50", "p75", "p90"],
              "properties": {
                "p25": {"type": "number", "minimum": 0},
                "p50": {"type": "number", "minimum": 0},
                "p75": {"type": "number", "minimum": 0},
                "p90": {"type": "number", "minimum": 0}
              },
              "additionalProperties": false
            },
            "shares": {
              "type": "object",
              "required": ["low_chroma_share", "mid_chroma_share", "high_chroma_share", "overflow_share"],
              "additionalProperties": {"$ref": "#/$defs/share"}
            },
            "histogram": {"$ref": "#/$defs/histogram"}
          },
          "additionalProperties": false
        },
        "hue_distribution": {
          "type": "object",
          "required": [
            "eligible_pixel_share", "eligible_pixel_count", "dominant_hue", "secondary_hue",
            "accent_hue", "hue_concentration", "concentration_definition", "sectors"
          ],
          "properties": {
            "eligible_pixel_share": {"$ref": "#/$defs/share"},
            "eligible_pixel_count": {"type": "integer", "minimum": 0},
            "dominant_hue": {"type": ["string", "null"]},
            "secondary_hue": {"type": ["string", "null"]},
            "accent_hue": {"type": ["string", "null"]},
            "hue_concentration": {"$ref": "#/$defs/share"},
            "concentration_definition": {"const": "dominant_chroma_weighted_share"},
            "sectors": {
              "type": "array",
              "minItems": 12,
              "maxItems": 12,
              "items": {
                "type": "object",
                "required": ["index", "label", "start_degree", "end_degree", "area_share", "chroma_weighted_share"],
                "properties": {
                  "index": {"type": "integer", "minimum": 0, "maximum": 11},
                  "label": {"enum": ["红", "橙", "黄", "黄绿", "绿", "青绿", "青", "蓝青", "蓝", "蓝紫", "洋红", "红紫"]},
                  "start_degree": {"type": "integer", "minimum": 0, "maximum": 330},
                  "end_degree": {"type": "integer", "minimum": 30, "maximum": 360},
                  "area_share": {"$ref": "#/$defs/share"},
                  "chroma_weighted_share": {"$ref": "#/$defs/share"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "neutral_axis": {
          "type": "object",
          "required": ["candidate_definition", "neutral_pixel_share", "neutral_spatial_coverage", "overall", "segments"],
          "properties": {
            "candidate_definition": {
              "type": "object",
              "required": ["c_max", "l_min", "l_max"],
              "properties": {
                "c_max": {"const": 8.0},
                "l_min": {"const": 10.0},
                "l_max": {"const": 95.0}
              },
              "additionalProperties": false
            },
            "neutral_pixel_share": {"$ref": "#/$defs/share"},
            "neutral_spatial_coverage": {"$ref": "#/$defs/share"},
            "overall": {"$ref": "#/$defs/axisSegment"},
            "segments": {
              "type": "object",
              "required": ["shadow", "midtone", "highlight"],
              "properties": {
                "shadow": {"$ref": "#/$defs/axisSegment"},
                "midtone": {"$ref": "#/$defs/axisSegment"},
                "highlight": {"$ref": "#/$defs/axisSegment"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "palettes": {
          "type": "object",
          "required": ["neutral_tone_palette", "scene_palette"],
          "properties": {
            "neutral_tone_palette": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {"$ref": "#/$defs/neutralPaletteItem"}
            },
            "scene_palette": {
              "type": "object",
              "required": ["status", "sample_count", "clusters"],
              "properties": {
                "status": {"enum": ["valid", "insufficient"]},
                "method": {"type": "string"},
                "seed": {"type": "integer"},
                "max_samples": {"type": "integer", "minimum": 1},
                "sample_count": {"type": "integer", "minimum": 0},
                "merge_delta_e00": {"type": "number", "minimum": 0},
                "clusters": {"type": "array", "items": {"$ref": "#/$defs/scenePaletteCluster"}},
                "roles": {
                  "type": "object",
                  "propertyNames": {"enum": ["primary", "secondary", "accent"]},
                  "additionalProperties": {"type": "string", "pattern": "^cluster_[1-9][0-9]*$"}
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "subject_background": {
          "type": "object",
          "required": ["status", "roi", "subject", "background", "delta_l", "delta_c", "delta_e00"],
          "properties": {
            "status": {"enum": ["valid", "insufficient"]},
            "roi": {
              "type": "object",
              "required": ["type", "box"],
              "properties": {
                "type": {"enum": ["face", "upper_body", "full_body", "main_subject"]},
                "box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}}
              },
              "additionalProperties": false
            },
            "subject": {"anyOf": [{"$ref": "#/$defs/regionStats"}, {"type": "null"}]},
            "background": {"anyOf": [{"$ref": "#/$defs/regionStats"}, {"type": "null"}]},
            "delta_l": {"$ref": "#/$defs/nullableNumber"},
            "delta_c": {"$ref": "#/$defs/nullableNumber"},
            "delta_e00": {"$ref": "#/$defs/nullableNumber"}
          },
          "additionalProperties": false
        },
        "confidence": {
          "type": "object",
          "required": ["lighting", "material_fx"],
          "properties": {
            "lighting": {
              "type": "object",
              "required": ["source", "quality", "ratio"],
              "properties": {
                "source": {"$ref": "#/$defs/nullableShare"},
                "quality": {"$ref": "#/$defs/nullableShare"},
                "ratio": {"$ref": "#/$defs/nullableShare"}
              },
              "additionalProperties": false
            },
