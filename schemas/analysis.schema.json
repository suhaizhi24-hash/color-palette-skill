{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color Palette Analysis 0.14.0",
  "type": "object",
  "required": [
    "schema_version",
    "ruleset_version",
    "official_language",
    "zero_token",
    "source",
    "analysis",
    "tone",
    "contrast",
    "saturation",
    "white_balance",
    "tonal_palette",
    "skin",
    "lighting",
    "light",
    "material_effects",
    "effects",
    "official_report",
    "render_policy"
  ],
  "properties": {
    "schema_version": {"const": "0.14.0"},
    "ruleset_version": {"const": "p1-rules-0.10.0"},
    "official_language": {"const": "zh-CN"},
    "zero_token": {"const": true},
    "source": {
      "type": "object",
      "required": [
        "filename",
        "format",
        "source_mode",
        "width",
        "height",
        "orientation",
        "sha256",
        "orientation_applied",
        "icc_present",
        "icc_conversion_applied",
        "working_space",
        "has_alpha",
        "valid_pixel_share",
        "analysis_source",
        "render_color_adjustment"
      ],
      "properties": {
        "filename": {"type": "string"},
        "format": {"type": ["string", "null"]},
        "source_mode": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "orientation": {"enum": ["portrait", "landscape", "square"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "orientation_applied": {"type": "boolean"},
        "icc_present": {"type": "boolean"},
        "icc_conversion_applied": {"type": "boolean"},
        "working_space": {"const": "sRGB"},
        "has_alpha": {"type": "boolean"},
        "valid_pixel_share": {"type": "number", "minimum": 0, "maximum": 1},
        "analysis_source": {"const": "original"},
        "render_color_adjustment": {"const": false}
      }
    },
    "tone": {
      "type": "object",
      "required": ["code", "label", "l_percentiles", "shares", "clipping"]
    },
    "contrast": {
      "type": "object",
      "required": ["span_l", "level", "description"],
      "properties": {"level": {"enum": ["低", "中", "高"]}}
    },
    "saturation": {
      "type": "object",
      "required": ["metric", "median", "level", "shares", "description"],
      "properties": {"level": {"enum": ["低", "中", "高"]}}
    },
    "white_balance": {
      "type": "object",
      "required": [
        "status",
        "judgement",
        "neutral_share",
        "neutral_spatial_coverage"
      ],
      "properties": {
        "neutral_share": {"type": "number", "minimum": 0, "maximum": 1},
        "neutral_spatial_coverage": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "tonal_palette": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "skin": {
      "type": "object",
      "required": [
        "status",
        "face_count",
        "detector",
        "requested_backend",
        "available_backends",
        "backend_degraded",
        "primary_anchor",
        "secondary_anchor"
      ],
      "properties": {
        "status": {"enum": ["单人", "多人不合并", "无人像", "未验证"]},
        "requested_backend": {"enum": ["auto", "opencv", "dlib", "none"]},
        "backend_degraded": {"type": "boolean"}
      }
    },
    "lighting": {
      "type": "object",
      "required": [
        "ruleset_version",
        "source",
        "quality",
        "ratio",
        "subject_roi",
        "debug"
      ],
      "properties": {
        "ruleset_version": {"const": "lighting-0.14.0"},
        "source": {
          "type": "object",
          "required": ["code", "display_name"],
          "properties": {
            "code": {
              "enum": [
                "natural",
                "studio",
                "flash",
                "mixed",
                "self_luminous",
                "unknown"
              ]
            },
            "display_name": {
              "enum": ["自然光", "人工棚拍", "人工闪光", "混合光", "自发光", "暂不判定"]
            }
          },
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "required": ["code", "display_name"],
          "properties": {
            "code": {"enum": ["hard", "soft", "not_applicable", "unknown"]},
            "display_name": {"enum": ["硬光", "柔光", "不适用", "暂不判定"]}
          },
          "additionalProperties": false
        },
        "ratio": {
          "type": "object",
          "required": ["code", "display_name"],
          "properties": {
            "code": {"enum": ["low", "medium", "high", "not_applicable", "unknown"]},
            "display_name": {"enum": ["低", "中", "高", "不适用", "暂不判定"]}
          },
          "additionalProperties": false
        },
        "subject_roi": {
          "type": "object",
          "required": ["type", "box", "valid_share"],
          "properties": {
            "type": {"enum": ["face", "upper_body", "full_body", "main_subject"]},
            "box": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "integer", "minimum": 0}
            },
            "valid_share": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "debug": {"type": "object"}
      },
      "additionalProperties": false
    },
    "light": {
      "type": "object",
      "required": ["source", "quality", "ratio", "status"],
      "properties": {
        "source": {"enum": ["自然光", "人工棚拍", "人工闪光", "混合光", "自发光", "暂不判定"]},
        "quality": {"enum": ["硬光", "柔光", "不适用", "暂不判定"]},
        "ratio": {"enum": ["低", "中", "高", "不适用", "暂不判定"]},
        "status": {"enum": ["已分析", "兼容旧版"]}
      },
      "additionalProperties": false
    },
    "material_effects": {
      "type": "object",
      "required": ["ruleset_version", "items", "summary", "status", "diagnostics"],
      "properties": {
        "ruleset_version": {"const": "material-fx-0.13.0"},
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/materialEffectItem"}
        },
        "summary": {"type": "string", "minLength": 1},
        "status": {"enum": ["已识别", "未发现明显"]},
        "diagnostics": {"type": "object"}
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "required": ["detected", "not_obvious", "conclusion", "status"]
    },
    "render_policy": {
      "type": "object",
      "required": ["official_report_format", "generate_jpg", "render_color_adjustment"],
      "properties": {
        "official_report_format": {"const": "png"},
        "generate_jpg": {"const": false},
        "render_color_adjustment": {"const": false}
      }
    },
    "official_report": {
      "type": "object",
      "required": [
        "官方语言",
        "官方模块",
        "影调结构",
        "明暗关系",
        "色彩浓度",
        "白平衡&色相",
        "影调色卡",
        "肤色锚点",
        "素材特效&光线构成"
      ],
      "properties": {
        "官方模块": {
          "const": [
            "影调结构",
            "明暗关系",
            "色彩浓度",
            "白平衡&色相",
            "影调色卡",
            "肤色锚点",
            "素材特效&光线构成"
          ]
        },
        "素材特效&光线构成": {
          "type": "object",
          "required": ["素材特效", "光线构成"],
          "properties": {
            "素材特效": {
              "type": "object",
              "required": ["标签", "结论"],
              "properties": {
                "标签": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "细颗粒",
                      "粗颗粒",
                      "柔化",
                      "高斯模糊",
                      "低清晰度",
                      "高光扩散",
                      "RGB 色彩偏移",
                      "画质降低",
                      "胶片扫描质感",
                      "胶片边框",
                      "灰尘",
                      "划痕",
                      "未发现明显素材特效"
                    ]
                  }
                },
                "结论": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "光线构成": {
              "type": "object",
              "required": ["光源", "光质", "光比"],
              "properties": {
                "光源": {"enum": ["自然光", "人工棚拍", "人工闪光", "混合光", "自发光", "暂不判定"]},
                "光质": {"enum": ["硬光", "柔光", "不适用", "暂不判定"]},
                "光比": {"enum": ["低", "中", "高", "不适用", "暂不判定"]}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "materialEffectItem": {
      "type": "object",
      "required": [
        "type",
        "display_name",
        "confidence",
        "evidence",
        "alternatives",
        "regions"
      ],
      "properties": {
        "type": {
          "enum": [
            "grain",
            "softness",
            "gaussian_blur",
            "low_clarity",
            "highlight_diffusion",
            "rgb_shift",
            "image_degradation",
            "film_scan",
            "film_border",
            "dust",
            "scratch"
          ]
        },
        "subtype": {"enum": ["fine", "coarse"]},
        "display_name": {
          "enum": [
            "细颗粒",
            "粗颗粒",
            "柔化",
            "高斯模糊",
            "低清晰度",
            "高光扩散",
            "RGB 色彩偏移",
            "画质降低",
            "胶片扫描质感",
            "胶片边框",
            "灰尘",
            "划痕"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "regions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
