{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/color-palette/ground_truth.schema.json",
  "title": "调色盘 Golden Dataset Ground Truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "samples"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset": {
      "type": "object",
      "required": ["name", "version", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["示例", "待验收", "已确认"]},
        "privacy": {"enum": ["公开", "私人"]},
        "confirmed_at": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "file_hint": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "expected": {
            "type": "object",
            "additionalProperties": true
          },
          "advisory": {
            "type": "object",
            "additionalProperties": true
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "value", "tolerance"],
              "properties": {
                "path": {"type": "string"},
                "value": {"type": "number"},
                "tolerance": {"type": "number", "minimum": 0},
                "severity": {"enum": ["required", "advisory"]}
              }
            }
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
